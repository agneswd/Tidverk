<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:converters="using:Tidverk.App.Converters"
             xmlns:vm="using:Tidverk.App.ViewModels"
             x:Class="Tidverk.App.Views.MonthWorkspaceView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="Grid#WorkspaceContent.compact">
      <Setter Property="Margin" Value="16,12" />
      <Setter Property="RowSpacing" Value="10" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="WorkspaceContent" Classes.compact="{Binding IsCompactInterface}" Margin="28,22,28,24" MaxWidth="1440" HorizontalAlignment="Stretch" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18" AutomationProperties.LandmarkType="Main">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
      <TextBlock Classes="h2" Text="{Binding MonthTitle}" AutomationProperties.HeadingLevel="1" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="8">
        <Button x:Name="PreviousMonthButton" Classes="Outline Icon" Command="{Binding PreviousMonthCommand}" AutomationProperties.Name="{DynamicResource L_PreviousMonth}" ToolTip.Tip="{DynamicResource L_PreviousMonth}"><shadui:ButtonAssist.Icon><PathIcon x:Name="PreviousMonthGlyph" Width="24" Height="24" RenderTransformOrigin="50%,50%" Data="{x:Static shadui:Icons.ChevronLeft}"><PathIcon.RenderTransform><ScaleTransform ScaleX="0.4166667" ScaleY="0.4166667" /></PathIcon.RenderTransform></PathIcon></shadui:ButtonAssist.Icon></Button>
        <Button x:Name="CurrentMonthButton" Classes="Outline" Command="{Binding TodayCommand}" Content="{DynamicResource L_CurrentMonth}" IsEnabled="{Binding !IsCurrentMonth}" IsVisible="{Binding !IsCompactInterface}" />
        <Button x:Name="CompactCurrentMonthButton" Classes="Outline Icon" Command="{Binding TodayCommand}" IsEnabled="{Binding !IsCurrentMonth}" IsVisible="{Binding IsCompactInterface}" AutomationProperties.Name="{DynamicResource L_CurrentMonth}" ToolTip.Tip="{DynamicResource L_CurrentMonth}"><shadui:ButtonAssist.Icon><PathIcon Classes="ui-icon" Data="{x:Static shadui:Icons.Calendar}" /></shadui:ButtonAssist.Icon></Button>
        <Button x:Name="NextMonthButton" Classes="Outline Icon" Command="{Binding NextMonthCommand}" AutomationProperties.Name="{DynamicResource L_NextMonth}" ToolTip.Tip="{DynamicResource L_NextMonth}"><shadui:ButtonAssist.Icon><PathIcon x:Name="NextMonthGlyph" Width="24" Height="24" RenderTransformOrigin="50%,50%" Data="{x:Static shadui:Icons.ChevronRight}"><PathIcon.RenderTransform><ScaleTransform ScaleX="0.4166667" ScaleY="0.4166667" /></PathIcon.RenderTransform></PathIcon></shadui:ButtonAssist.Icon></Button>
        <shadui:SimpleDropdown x:Name="MonthActionsMenu" Classes="Outline" PopupWidth="248" AutomationProperties.Name="{DynamicResource L_MonthActions}" ToolTip.Tip="{DynamicResource L_MonthActions}">
          <shadui:SimpleDropdown.TriggerContent><PathIcon Classes="ui-icon" Data="{x:Static shadui:Icons.Calendar}" /></shadui:SimpleDropdown.TriggerContent>
          <Button Command="{Binding OpenFillMonthConfirmationCommand}" Content="{DynamicResource L_FillNormalWorkdays}" />
          <Button Command="{Binding CopyMonthCommand}" Content="{DynamicResource L_CopyMonth}" IsEnabled="{Binding IsMonthStarted}" />
          <Button Command="{Binding OpenPasteMonthConfirmationCommand}" Content="{DynamicResource L_PasteMonth}" IsEnabled="{Binding CanPasteMonth}" />
          <Separator />
          <Button Classes="destructive-action" Command="{Binding OpenResetMonthConfirmationCommand}" Content="{DynamicResource L_ResetMonth}" IsEnabled="{Binding CanResetMonth}" />
        </shadui:SimpleDropdown>
        <Button Classes="Primary" Margin="8,0,0,0" Command="{Binding OpenReportCommand}" Content="{DynamicResource L_ExportReport}" IsEnabled="{Binding IsMonthStarted}" IsVisible="{Binding !IsCompactInterface}"><shadui:ButtonAssist.Icon><PathIcon Classes="ui-icon leading-icon" Data="{x:Static shadui:Icons.ClipBoard}" /></shadui:ButtonAssist.Icon></Button>
        <Button Classes="Primary Icon" Margin="8,0,0,0" Command="{Binding OpenReportCommand}" IsEnabled="{Binding IsMonthStarted}" IsVisible="{Binding IsCompactInterface}" AutomationProperties.Name="{DynamicResource L_ExportReport}" ToolTip.Tip="{DynamicResource L_ExportReport}"><shadui:ButtonAssist.Icon><PathIcon Classes="ui-icon" Data="{x:Static shadui:Icons.ClipBoard}" /></shadui:ButtonAssist.Icon></Button>
      </StackPanel>
    </Grid>

    <UniformGrid Grid.Row="1" Columns="{Binding #WorkspaceContent.Bounds.Width, Converter={x:Static converters:DisplayConverters.MetricColumns}}" Margin="-6" IsVisible="{Binding IsLedger}">
      <shadui:Card Classes="metric-card" Margin="6" Padding="18" HasShadow="False">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
          <Grid Classes="metric-header" ColumnDefinitions="*,Auto"><TextBlock Classes="Caption Muted" FontWeight="SemiBold" Text="{DynamicResource L_Worked}" /><PathIcon Grid.Column="1" Classes="metric-icon" Data="{x:Static shadui:Icons.DateTime}" /></Grid>
          <TextBlock Grid.Row="1" Classes="metric-value" Text="{Binding WorkedText}" />
          <TextBlock Grid.Row="2" Classes="Caption Muted" Text="{Binding WorkedBreakdownText}" IsVisible="{Binding HasWorkedBreakdown}" TextWrapping="Wrap" />
        </Grid>
      </shadui:Card>
      <shadui:Card Classes="metric-card" Margin="6" Padding="18" HasShadow="False">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
          <Grid Classes="metric-header" ColumnDefinitions="*,Auto">
            <TextBlock Classes="Caption Muted" FontWeight="SemiBold" Text="{Binding TimeBalanceTitle}" />
            <Button x:Name="BalanceAdjustmentButton" Grid.Column="1" Classes="Ghost Icon metric-action" Command="{Binding OpenBalanceAdjustmentCommand}" AutomationProperties.Name="{DynamicResource L_BalanceAdjust}" ToolTip.Tip="{DynamicResource L_BalanceAdjust}"><shadui:ButtonAssist.Icon><PathIcon Classes="ui-icon metric-icon metric-action-icon" Data="{x:Static shadui:Icons.ArrowDown}" /></shadui:ButtonAssist.Icon></Button>
          </Grid>
          <TextBlock Grid.Row="1" Classes="metric-value" Text="{Binding BalanceText}" />
          <TextBlock Grid.Row="2" Classes="Caption Muted" Text="{Binding TimeBalanceDescription}" />
        </Grid>
      </shadui:Card>
      <shadui:Card Classes="metric-card" Margin="6" Padding="18" HasShadow="False">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
          <Grid Classes="metric-header" ColumnDefinitions="*,Auto"><TextBlock Classes="Caption Muted" FontWeight="SemiBold" Text="{DynamicResource L_GrossPay}" /><PathIcon Grid.Column="1" Classes="metric-icon" Data="{x:Static shadui:Icons.ClipBoard}" /></Grid>
          <TextBlock Grid.Row="1" Classes="metric-value" Text="{Binding GrossText}" />
          <ItemsControl x:Name="PayBreakdownLines" Grid.Row="2" ItemsSource="{Binding PayLines}" IsVisible="{Binding HasPayLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PayLine">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Classes="Caption Muted" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="Caption Muted" Text="{Binding Amount}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Grid.Row="3" Classes="Caption Muted" Text="{Binding GrossPayNote}" TextWrapping="Wrap" />
        </Grid>
      </shadui:Card>
      <shadui:Card Classes="metric-card" Margin="6" Padding="18" HasShadow="False">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
          <Grid Classes="metric-header" ColumnDefinitions="*,Auto"><TextBlock Classes="Caption Muted" FontWeight="SemiBold" Text="{DynamicResource L_EstimatedNet}" /><PathIcon Grid.Column="1" Classes="metric-icon" Data="{x:Static shadui:Icons.ClipBoardCheck}" /></Grid>
          <TextBlock Grid.Row="1" Classes="metric-value" Text="{Binding TaxText}" />
          <TextBlock Grid.Row="2" Classes="Caption Muted" Text="{DynamicResource L_BasedOnTaxSettings}" />
        </Grid>
      </shadui:Card>
    </UniformGrid>

    <Border Grid.Row="1" Classes="compact-metrics" IsVisible="{Binding ShowsCalendarMetrics}">
      <UniformGrid Columns="4">
        <StackPanel Spacing="2"><TextBlock Classes="Caption Muted" Text="{DynamicResource L_Worked}" /><TextBlock FontWeight="SemiBold" Text="{Binding WorkedText}" /></StackPanel>
        <StackPanel Spacing="2"><TextBlock Classes="Caption Muted" Text="{Binding TimeBalanceTitle}" /><TextBlock FontWeight="SemiBold" Text="{Binding BalanceText}" /></StackPanel>
        <StackPanel Spacing="2"><TextBlock Classes="Caption Muted" Text="{DynamicResource L_GrossPay}" /><TextBlock FontWeight="SemiBold" Text="{Binding GrossText}" /></StackPanel>
        <StackPanel Spacing="2"><TextBlock Classes="Caption Muted" Text="{DynamicResource L_EstimatedNet}" /><TextBlock FontWeight="SemiBold" Text="{Binding TaxText}" /></StackPanel>
      </UniformGrid>
    </Border>

    <StackPanel Grid.Row="2" Spacing="10">
      <Border Classes="notice success" IsVisible="{Binding HasMonthActionStatus}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><PathIcon Classes="ui-icon" Data="{x:Static shadui:Icons.Success}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding MonthActionStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><Button x:Name="DismissMonthActionStatusButton" Grid.Column="2" Classes="Ghost Icon" Command="{Binding DismissMonthActionStatusCommand}" AutomationProperties.Name="{DynamicResource L_Close}" ToolTip.Tip="{DynamicResource L_Close}"><PathIcon Classes="ui-icon button-icon-16" Data="{x:Static shadui:Icons.Cross}" /></Button></Grid></Border>
      <Border Classes="notice neutral" IsVisible="{Binding IsMonthUnstarted}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border Classes="notice-icon neutral"><PathIcon Classes="ui-icon" Data="{x:Static shadui:Icons.Calendar}" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock FontWeight="SemiBold" Text="{DynamicResource L_MonthNotStarted}" /><TextBlock Classes="Caption Muted" Text="{DynamicResource L_MonthNotStartedDescription}" /></StackPanel><Button Grid.Column="2" Classes="Outline" Command="{Binding StartMonthCommand}" Content="{DynamicResource L_AddFirstEntry}" /></Grid></Border>
      <Border Classes="notice warning" IsVisible="{Binding HasMissingDays}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border Classes="notice-icon warning"><PathIcon Classes="ui-icon" Data="{x:Static shadui:Icons.Warning}" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock FontWeight="SemiBold" Text="{DynamicResource L_IncompleteTimesheet}" /><TextBlock Classes="Caption Muted" Text="{Binding MissingNotice}" /></StackPanel><Button Grid.Column="2" Classes="Ghost" Command="{Binding StartCatchUpCommand}" Content="{DynamicResource L_CompleteMissingDays}" /></Grid></Border>
    </StackPanel>

    <shadui:Card Grid.Row="3" x:Name="LedgerView" Classes="data-surface" Padding="0" IsVisible="{Binding IsLedger}" HasShadow="False">
      <Grid RowDefinitions="42,*">
        <Border x:Name="LedgerHeader" Classes="table-header"><Grid ColumnDefinitions="1.65*,1.05*,0.65*,0.55*,0.85*,1.35*,92" Margin="18,0"><TextBlock Classes="table-head" Text="{DynamicResource L_Date}" /><TextBlock Grid.Column="1" Classes="table-head" Text="{DynamicResource L_Time}" /><TextBlock Grid.Column="2" Classes="table-head" Text="{DynamicResource L_Lunch}" /><TextBlock Grid.Column="3" Classes="table-head" Text="{DynamicResource L_Hours}" /><TextBlock Grid.Column="4" Classes="table-head" Text="{DynamicResource L_Project}" /><TextBlock Grid.Column="5" Classes="table-head" Text="{DynamicResource L_Pay}" /><TextBlock Grid.Column="6" Classes="table-head" HorizontalAlignment="Right" Text="{DynamicResource L_Status}" /></Grid></Border>
        <ScrollViewer x:Name="LedgerRowsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DayItemViewModel">
                <Grid Classes="ledger-row" Classes.weekend="{Binding IsWeekend}" Classes.missing="{Binding IsMissing}" Classes.selected="{Binding IsSelected}" Classes.today="{Binding IsToday}">
                  <Border BorderBrush="{DynamicResource BorderColor30}" BorderThickness="0,0,0,1" IsHitTestVisible="False" />
                  <Grid Margin="18,0" ColumnDefinitions="1.65*,1.05*,0.65*,0.55*,0.85*,1.35*,92" IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock FontWeight="Medium" Text="{Binding DateText}" /><TextBlock Classes="Caption Muted" Text="{Binding HolidayText}" /></StackPanel>
                    <TextBlock Grid.Column="1" Classes.Muted="{Binding IsPending}" VerticalAlignment="Center" Text="{Binding TimeText}" /><TextBlock Grid.Column="2" Classes="Muted" VerticalAlignment="Center" Text="{Binding LunchText}" /><TextBlock Grid.Column="3" FontWeight="Medium" VerticalAlignment="Center" Text="{Binding HoursText}" /><TextBlock Grid.Column="4" Classes="Muted" VerticalAlignment="Center" Text="{Binding ProjectText}" /><TextBlock Grid.Column="5" Classes="Muted" VerticalAlignment="Center" Text="{Binding PayText}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Button Classes="Outline ledger-action" Margin="0,0,18,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding $parent[shadui:Window].((vm:MainWindowViewModel)DataContext).OpenEditorCommand}" CommandParameter="{Binding}" Content="{Binding ActionText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </shadui:Card>

    <shadui:Card Grid.Row="3" x:Name="CalendarView" Classes="data-surface" Padding="0" IsVisible="{Binding IsCalendar}" HasShadow="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <Grid RowDefinitions="42,*">
        <Border Classes="table-header"><UniformGrid Columns="7" Width="{Binding #CalendarView.Bounds.Width}"><TextBlock Classes="calendar-head" Text="{DynamicResource L_WeekdayMon}" /><TextBlock Classes="calendar-head" Text="{DynamicResource L_WeekdayTue}" /><TextBlock Classes="calendar-head" Text="{DynamicResource L_WeekdayWed}" /><TextBlock Classes="calendar-head" Text="{DynamicResource L_WeekdayThu}" /><TextBlock Classes="calendar-head" Text="{DynamicResource L_WeekdayFri}" /><TextBlock Classes="calendar-head" Text="{DynamicResource L_WeekdaySat}" /><TextBlock Classes="calendar-head" Text="{DynamicResource L_WeekdaySun}" /></UniformGrid></Border>
          <ItemsControl x:Name="CalendarDaysItems" Grid.Row="1" ItemsSource="{Binding CalendarDays}" ClipToBounds="True">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DayItemViewModel">
                <Button Classes="calendar-cell" Classes.weekend="{Binding IsWeekend}" Classes.missing="{Binding IsMissing}" Classes.selected="{Binding IsSelected}" Classes.today="{Binding IsToday}" IsEnabled="{Binding IsInMonth}" AutomationProperties.Name="{Binding DateText}" Command="{Binding $parent[shadui:Window].((vm:MainWindowViewModel)DataContext).OpenEditorCommand}" CommandParameter="{Binding}">
                  <Grid RowDefinitions="Auto,*"><Border Classes="today-marker" Classes.current="{Binding IsToday}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DayNumber}" /></Border><TextBlock Grid.Row="1" Margin="0,4,0,0" Classes="Caption" Classes.Muted="{Binding IsPending}" FontWeight="Medium" Text="{Binding CalendarTimeText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HolidayText}" /></Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
      </Grid>
    </shadui:Card>
  </Grid>
</UserControl>
