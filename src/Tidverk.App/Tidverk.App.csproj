<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Tidverk</AssemblyName>
    <RootNamespace>Tidverk.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/Brand/tidverk-app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <ProjectReference Include="../Tidverk.Core/Tidverk.Core.csproj" />
    <ProjectReference Include="../Tidverk.Infrastructure/Tidverk.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="ShadUI" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tidverk.App.Tests" />
  </ItemGroup>
</Project>
